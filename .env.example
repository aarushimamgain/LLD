# Supabase (optional: if unset, the app falls back to InMemoryAttemptRepository)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider: mock | openai | gemini | anthropic  (mock needs no key)
LLM_PROVIDER=mock
LLM_API_KEY=
# Optional model override. Defaults: anthropic=claude-opus-5-5, gemini=gemini-2.5-flash, openai=gpt-4.1-mini
LLM_MODEL=

# Max time (ms) for the AI review (including its one retry) before falling back to rule-based
# feedback only. ~8000 suits gemini/openai mini models; use ~30000 for anthropic (it reasons first).
EVAL_TIMEOUT_MS=8000

PORT=3000
